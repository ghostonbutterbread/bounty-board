# TEST ONLY: same layout as sandbox/Dockerfile, built from a locally present
# image without network access (no apt). Used by tests/test_terminal_docker.py.
FROM python:3.12-slim
ARG UID=1000
ARG GID=1000
RUN groupadd -g "${GID}" sandbox \
 && useradd -m -u "${UID}" -g "${GID}" -d /home/sandbox -s /bin/bash sandbox \
 && mkdir -p /report /run/bbterm
COPY bbterm-forward.py /usr/local/bin/bbterm-forward
COPY bbterm-ports.py /usr/local/bin/bbterm-ports
COPY bashrc /etc/bbterm.bashrc
RUN chmod 0755 /usr/local/bin/bbterm-forward /usr/local/bin/bbterm-ports \
 && echo '[ -f /etc/bbterm.bashrc ] && . /etc/bbterm.bashrc' >> /etc/bash.bashrc \
 && echo '[ -f /etc/bbterm.bashrc ] && . /etc/bbterm.bashrc' >> /etc/profile
USER sandbox
WORKDIR /report
# The same process runs the preview-ports agent as a supervised thread; it dials
# out to /run/bbterm/ports.sock (only present with --preview-ports).
CMD ["python3", "/usr/local/bin/bbterm-forward", "3128", "/run/bbterm/proxy.sock", "/run/bbterm/ports.sock"]
