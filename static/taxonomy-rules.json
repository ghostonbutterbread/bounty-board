{
  "version": 1,
  "notes": "Single source of truth for display-time class and severity normalization. Consumed by taxonomy.py and static/modules/taxonomy.js. Raw values are never rewritten. Rules are tried in order; the first match is primary and later matching categories are reported as alternates. Patterns run against the normalized label: lowercase, every run of non-alphanumeric characters replaced by one space. Keep patterns to the common subset of Python re and JavaScript RegExp (no lookbehind, no named groups, no inline flags).",
  "severity": {
    "canonical": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", "UNKNOWN"],
    "passthrough": ["EXCEPTIONAL"],
    "aliases": {"P1": "CRITICAL", "P2": "HIGH", "P3": "MEDIUM", "P4": "LOW", "P5": "INFO", "INFORMATIONAL": "INFO"},
    "placeholders": ["LOW|MEDIUM|HIGH|CRITICAL", "CRITICAL|HIGH|MEDIUM|LOW", "TBD", "TODO", "N/A", "NA", "?"],
    "ranges": "^(CRITICAL|HIGH|MEDIUM|LOW|INFO)\\s*(-|TO|/)\\s*(CRITICAL|HIGH|MEDIUM|LOW|INFO)$",
    "unmapped_notes": {"P0": "BBH does not alias P0; shown as UNKNOWN to stay consistent with BBH.", "NONE": "Not a severity; shown as UNKNOWN."}
  },
  "unclassified": {"id": "unclassified", "label": "Unclassified"},
  "junk": ["", "unknown", "novel", "none", "n a", "na", "tbd", "todo", "other", "misc", "short vulnerability label", "vulnerability class", "class", "type"],
  "categories": [
    {"id": "broken_access_control", "label": "Broken Access Control", "subclasses": [
      {"id": "idor", "label": "IDOR / object-level"},
      {"id": "privilege_escalation", "label": "Privilege escalation"},
      {"id": "missing_authorization", "label": "Missing or bypassable authorization"}]},
    {"id": "authentication_session", "label": "Authentication and Session", "subclasses": [
      {"id": "broken_authentication", "label": "Broken authentication"},
      {"id": "missing_authentication", "label": "Missing authentication"},
      {"id": "account_takeover", "label": "Account takeover / password reset"},
      {"id": "oauth", "label": "OAuth / SSO"},
      {"id": "mfa", "label": "MFA"},
      {"id": "session_management", "label": "Session management"},
      {"id": "token_jwt", "label": "Token / JWT"},
      {"id": "brute_force", "label": "Brute force / rate limiting"},
      {"id": "enumeration", "label": "Account enumeration"}]},
    {"id": "xss", "label": "Cross-Site Scripting", "subclasses": [
      {"id": "stored", "label": "Stored"},
      {"id": "reflected", "label": "Reflected"},
      {"id": "dom", "label": "DOM-based"},
      {"id": "other", "label": "Unspecified"}]},
    {"id": "server_injection", "label": "Server-Side Injection", "subclasses": [
      {"id": "sqli", "label": "SQL injection"},
      {"id": "ssti", "label": "Template injection"},
      {"id": "command", "label": "Command injection"},
      {"id": "xxe", "label": "XXE"},
      {"id": "parameter", "label": "Parameter injection"},
      {"id": "input_validation", "label": "Input validation"}]},
    {"id": "client_injection", "label": "Client-Side Injection", "subclasses": [
      {"id": "prototype_pollution", "label": "Prototype pollution"},
      {"id": "css", "label": "CSS injection"},
      {"id": "csv_formula", "label": "CSV formula injection"}]},
    {"id": "rce", "label": "Remote Code Execution", "subclasses": [
      {"id": "deserialization", "label": "Unsafe deserialization"},
      {"id": "ai_agent", "label": "Via AI agent or sandbox"},
      {"id": "exec_sink", "label": "Exec sink reachability"},
      {"id": "other", "label": "Other / unspecified"}]},
    {"id": "ssrf", "label": "Server-Side Request Forgery", "subclasses": [
      {"id": "other", "label": "Unspecified"}]},
    {"id": "sensitive_data_exposure", "label": "Sensitive Data Exposure", "subclasses": [
      {"id": "information_disclosure", "label": "Information disclosure"},
      {"id": "secrets", "label": "Secrets / hardcoded credentials"},
      {"id": "source_disclosure", "label": "Source or config disclosure"}]},
    {"id": "misconfiguration", "label": "Security Misconfiguration", "subclasses": [
      {"id": "cors", "label": "CORS"},
      {"id": "security_control_bypass", "label": "Security control bypass"},
      {"id": "subdomain_takeover", "label": "Subdomain takeover / dangling DNS"},
      {"id": "error_handling", "label": "Error handling"},
      {"id": "environment", "label": "Environment confusion"}]},
    {"id": "business_logic", "label": "Business Logic", "subclasses": [
      {"id": "race_condition", "label": "Race condition"},
      {"id": "payment", "label": "Payment / value"},
      {"id": "other", "label": "Workflow / other"}]},
    {"id": "csrf", "label": "CSRF", "subclasses": [{"id": "other", "label": "Unspecified"}]},
    {"id": "open_redirect", "label": "Open Redirect", "subclasses": [{"id": "other", "label": "Unspecified"}]},
    {"id": "file_handling", "label": "File Handling", "subclasses": [
      {"id": "path_traversal", "label": "Path traversal / LFI"},
      {"id": "upload", "label": "File upload"}]},
    {"id": "app_integration", "label": "Insecure Application Integration", "subclasses": [
      {"id": "ipc", "label": "IPC / RPC bridge"},
      {"id": "deeplink_protocol", "label": "Deep link / custom protocol"},
      {"id": "webview_native", "label": "WebView / native module"},
      {"id": "debug_surface", "label": "Debug surface"},
      {"id": "other", "label": "Other"}]},
    {"id": "memory_safety", "label": "Memory Safety", "subclasses": [{"id": "other", "label": "Unspecified"}]},
    {"id": "ai_security", "label": "AI Feature Security", "subclasses": [
      {"id": "prompt_injection", "label": "Prompt injection"},
      {"id": "indirect_prompt_injection", "label": "Indirect prompt injection"},
      {"id": "agent_tool_abuse", "label": "Agent / tool abuse"}]},
    {"id": "denial_of_service", "label": "Denial of Service", "subclasses": [{"id": "other", "label": "Unspecified"}]}
  ],
  "aliases": {
    "ato": "authentication_session/account_takeover",
    "account takeover": "authentication_session/account_takeover",
    "auth": "authentication_session/broken_authentication",
    "authn": "authentication_session/broken_authentication",
    "authentication": "authentication_session/broken_authentication",
    "mfa": "authentication_session/mfa",
    "oauth": "authentication_session/oauth",
    "oauth2": "authentication_session/oauth",
    "authz": "broken_access_control/missing_authorization",
    "authorization": "broken_access_control/missing_authorization",
    "access control": "broken_access_control/missing_authorization",
    "broken access control": "broken_access_control/missing_authorization",
    "idor": "broken_access_control/idor",
    "bola": "broken_access_control/idor",
    "xss": "xss/other",
    "sqli": "server_injection/sqli",
    "ssti": "server_injection/ssti",
    "rce": "rce/other",
    "ssrf": "ssrf/other",
    "csrf": "csrf/other",
    "cors": "misconfiguration/cors",
    "logic": "business_logic/other",
    "race": "business_logic/race_condition",
    "upload": "file_handling/upload",
    "info disclosure": "sensitive_data_exposure/information_disclosure",
    "information disclosure": "sensitive_data_exposure/information_disclosure",
    "sensitive data exposure": "sensitive_data_exposure/information_disclosure"
  },
  "rules": [
    {"id": "rce-ai", "to": "rce/ai_agent", "patterns": ["\\brce\\b.*\\bai\\b", "\\bai\\b.*\\brce\\b"]},
    {"id": "rce-deser", "to": "rce/deserialization", "patterns": ["deserializ"]},
    {"id": "rce-sink", "to": "rce/exec_sink", "patterns": ["exec sink"]},
    {"id": "rce", "to": "rce/other", "patterns": ["\\brce\\b", "remote code", "code execution"]},
    {"id": "inj-sqli", "to": "server_injection/sqli", "patterns": ["\\bsqli\\b", "sql injection"]},
    {"id": "inj-ssti", "to": "server_injection/ssti", "patterns": ["\\bssti\\b", "template injection"]},
    {"id": "inj-cmd", "to": "server_injection/command", "patterns": ["command injection", "\\bcmdi\\b", "os command"]},
    {"id": "inj-xxe", "to": "server_injection/xxe", "patterns": ["\\bxxe\\b", "xml external"]},
    {"id": "ssrf", "to": "ssrf/other", "patterns": ["\\bssrf\\b", "server side request"]},
    {"id": "xss-stored", "to": "xss/stored", "patterns": ["stored xss", "persistent xss", "stored cross site", "cross site scripting stored", "cross site scripting.*\\bstored\\b"]},
    {"id": "xss-dom", "to": "xss/dom", "patterns": ["\\bdom xss\\b", "dom based", "\\bdom\\b.*\\bxss\\b", "\\bxss\\b.*\\bdom\\b"]},
    {"id": "xss-reflected", "to": "xss/reflected", "patterns": ["reflected xss", "reflected cross site", "\\bxss\\b.*\\breflected\\b"]},
    {"id": "xss", "to": "xss/other", "patterns": ["\\bxss\\b", "cross site scripting"]},
    {"id": "csrf", "to": "csrf/other", "patterns": ["\\bcsrf\\b", "cross site request forgery"]},
    {"id": "prompt-indirect", "to": "ai_security/indirect_prompt_injection", "patterns": ["indirect prompt injection"]},
    {"id": "prompt", "to": "ai_security/prompt_injection", "patterns": ["prompt injection"]},
    {"id": "ai-tools", "to": "ai_security/agent_tool_abuse", "patterns": ["ai action chain", "agent tool", "\\bmcp\\b"]},
    {"id": "oauth", "to": "authentication_session/oauth", "patterns": ["\\boauth\\b", "oauth2", "\\bsso\\b", "redirect uri", "\\bpkce\\b"]},
    {"id": "open-redirect", "to": "open_redirect/other", "patterns": ["open redirect", "redirect target"]},
    {"id": "path-traversal", "to": "file_handling/path_traversal", "patterns": ["path traversal", "directory traversal", "\\blfi\\b", "local file inclusion"]},
    {"id": "idor", "to": "broken_access_control/idor", "patterns": ["\\bidor\\b", "direct object reference", "\\bbola\\b", "object level", "object authorization", "object binding", "ownership check", "tenant authorization", "cross tenant", "\\bcwe 639\\b"]},
    {"id": "priv-esc", "to": "broken_access_control/privilege_escalation", "patterns": ["privilege escalation", "improper privilege", "vertical privilege"]},
    {"id": "race", "to": "business_logic/race_condition", "patterns": ["\\brace\\b", "race condition", "toctou", "concurrency"]},
    {"id": "payment", "to": "business_logic/payment", "patterns": ["\\bpayment\\b"]},
    {"id": "logic", "to": "business_logic/other", "patterns": ["business logic", "^logic$", "workflow abuse"]},
    {"id": "auth-missing", "to": "authentication_session/missing_authentication", "patterns": ["missing authentication"]},
    {"id": "auth-brute", "to": "authentication_session/brute_force", "patterns": ["brute force", "excessive authentication", "rate limit"]},
    {"id": "auth-enum", "to": "authentication_session/enumeration", "patterns": ["enumeration", "observable response discrepancy"]},
    {"id": "auth-session", "to": "authentication_session/session_management", "patterns": ["session expiration", "session invalidation", "session management", "session fixation", "\\bsession\\b"]},
    {"id": "auth-ato", "to": "authentication_session/account_takeover", "patterns": ["\\bato\\b", "account takeover", "password reset"]},
    {"id": "auth-jwt", "to": "authentication_session/token_jwt", "patterns": ["\\bjwt\\b", "\\bjws\\b", "\\bjwk"]},
    {"id": "auth-mfa", "to": "authentication_session/mfa", "patterns": ["\\bmfa\\b", "two factor"]},
    {"id": "auth-broken", "to": "authentication_session/broken_authentication", "patterns": ["broken authentication", "\\bauthentication\\b", "^auth\\b", "\\bauth flow\\b", "\\bauth bypass\\b", "auth bypass"]},
    {"id": "bac", "to": "broken_access_control/missing_authorization", "patterns": ["access control", "\\bauthz\\b", "authorization bypass", "^authorization$", "api authorization", "api access", "forced browsing", "improper authorization"]},
    {"id": "upload", "to": "file_handling/upload", "patterns": ["\\bupload\\b"]},
    {"id": "secrets", "to": "sensitive_data_exposure/secrets", "patterns": ["hardcoded", "secrets? exposure", "\\bcwe 798\\b", "credential exposure", "leaked secret"]},
    {"id": "source-disclosure", "to": "sensitive_data_exposure/source_disclosure", "patterns": ["source disclosure", "source code exposure"]},
    {"id": "info", "to": "sensitive_data_exposure/information_disclosure", "patterns": ["information disclosure", "info disclosure", "sensitive information", "sensitive data", "data exposure", "\\bpii\\b", "\\bcwe 200\\b", "\\bdisclosure\\b"]},
    {"id": "subdomain", "to": "misconfiguration/subdomain_takeover", "patterns": ["subdomain takeover", "dangling dns"]},
    {"id": "cors", "to": "misconfiguration/cors", "patterns": ["\\bcors\\b"]},
    {"id": "sec-bypass", "to": "misconfiguration/security_control_bypass", "patterns": ["security control bypass", "protection mechanism failure", "waf bypass", "allowlist bypass"]},
    {"id": "environment", "to": "misconfiguration/environment", "patterns": ["environment confusion"]},
    {"id": "error-handling", "to": "misconfiguration/error_handling", "patterns": ["^error handling$"]},
    {"id": "dos", "to": "denial_of_service/other", "patterns": ["denial of service", "\\bdos\\b"]},
    {"id": "proto", "to": "client_injection/prototype_pollution", "patterns": ["prototype pollution"]},
    {"id": "css", "to": "client_injection/css", "patterns": ["css injection"]},
    {"id": "csv", "to": "client_injection/csv_formula", "patterns": ["csv formula", "formula injection"]},
    {"id": "param-injection", "to": "server_injection/parameter", "patterns": ["parameter injection"]},
    {"id": "input-validation", "to": "server_injection/input_validation", "patterns": ["input validation"]},
    {"id": "memory", "to": "memory_safety/other", "patterns": ["memory unsafe", "memory corruption", "buffer overflow", "use after free"]},
    {"id": "app-debug", "to": "app_integration/debug_surface", "patterns": ["\\bcdp\\b", "debug port"]},
    {"id": "app-ipc", "to": "app_integration/ipc", "patterns": ["\\bipc\\b", "\\bhostrpc\\b", "\\brpc\\b"]},
    {"id": "app-deeplink", "to": "app_integration/deeplink_protocol", "patterns": ["deep ?link", "custom protocol", "custom scheme", "file association", "open external", "external navigation"]},
    {"id": "app-native", "to": "app_integration/webview_native", "patterns": ["\\bwebview\\b", "native module", "native bridge", "node integration", "\\belectron\\b"]}
  ]
}
