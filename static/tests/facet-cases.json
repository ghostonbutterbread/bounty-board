{
 "notes": "Shared facet-key cases (synthetic). tests/test_finding_facets.py runs them against finding_facets.py and static/tests/filter-bar.test.cjs against BoardFilterBar.keys, so Recent (server) and Submissions (browser) bucket findings the same way. finding null = a report with no linked finding.",
 "cases": [
  {"name": "no linked finding", "finding": null, "submission": "none", "severity": "none", "class": "none"},
  {"name": "missing submission", "finding": {"severity": "HIGH", "class_name": "xss"}, "submission": "not_submitted", "severity": "high", "class": "xss"},
  {"name": "explicit not_submitted", "finding": {"submission": {"state": "not_submitted"}, "severity": "medium"}, "submission": "not_submitted", "severity": "medium", "class": "unclassified"},
  {"name": "empty state", "finding": {"submission": {"state": ""}}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "not submitted with a space", "finding": {"submission": {"state": "Not Submitted"}}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "none state", "finding": {"submission": {"state": "none"}}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "draft", "finding": {"submission": {"state": "draft"}}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "unsubmitted", "finding": {"submission": {"state": "unsubmitted"}}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "submitted awaiting result", "finding": {"submission": {"state": "submitted"}, "severity": "CRITICAL"}, "submission": "submitted", "severity": "critical", "class": "unclassified"},
  {"name": "submitted with padding and case", "finding": {"submission": {"state": " Submitted "}}, "submission": "submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "duplicate result wins", "finding": {"submission": {"state": "submitted", "result": "duplicate"}}, "submission": "duplicate", "severity": "unknown", "class": "unclassified"},
  {"name": "valid result wins", "finding": {"submission": {"state": "submitted", "result": "Valid"}}, "submission": "valid", "severity": "unknown", "class": "unclassified"},
  {"name": "result wins over any state", "finding": {"submission": {"state": "dropped", "result": "duplicate"}}, "submission": "duplicate", "severity": "unknown", "class": "unclassified"},
  {"name": "unknown result ignored", "finding": {"submission": {"state": "submitted", "result": "informative"}}, "submission": "submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "dropped", "finding": {"submission": {"state": "dropped"}}, "submission": "dropped", "severity": "unknown", "class": "unclassified"},
  {"name": "raw state is other", "finding": {"submission": {"state": "raw"}}, "submission": "other", "severity": "unknown", "class": "unclassified"},
  {"name": "legacy submission_status fallback", "finding": {"submission_status": "submitted"}, "submission": "submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "legacy fallback when nested state is empty", "finding": {"submission": {"state": ""}, "submission_status": "dropped"}, "submission": "dropped", "severity": "unknown", "class": "unclassified"},
  {"name": "nested state beats legacy", "finding": {"submission": {"state": "submitted"}, "submission_status": "not_submitted"}, "submission": "submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "submission not an object", "finding": {"submission": "submitted"}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "severity alias P2", "finding": {"severity": "P2"}, "submission": "not_submitted", "severity": "high", "class": "unclassified"},
  {"name": "severity exceptional", "finding": {"severity": "EXCEPTIONAL"}, "submission": "not_submitted", "severity": "exceptional", "class": "unclassified"},
  {"name": "severity informational", "finding": {"severity": "informational"}, "submission": "not_submitted", "severity": "info", "class": "unclassified"},
  {"name": "severity placeholder", "finding": {"severity": "LOW|MEDIUM|HIGH|CRITICAL"}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "severity range", "finding": {"severity": "medium-high"}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "severity empty", "finding": {"severity": ""}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "class via browser field name", "finding": {"class": "idor"}, "submission": "not_submitted", "severity": "unknown", "class": "broken_access_control"},
  {"name": "class with subclass", "finding": {"class_name": "Cross-Site Scripting (stored)"}, "submission": "not_submitted", "severity": "unknown", "class": "xss"},
  {"name": "class junk placeholder", "finding": {"class_name": "short vulnerability label"}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "class no rule", "finding": {"class_name": "zzz mystery"}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "class not a string", "finding": {"class_name": 7}, "submission": "not_submitted", "severity": "unknown", "class": "unclassified"},
  {"name": "class ssrf", "finding": {"class_name": "ssrf"}, "submission": "not_submitted", "severity": "unknown", "class": "ssrf"}
 ]
